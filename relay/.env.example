# Shared with the module's "API Key" setting. Generate with: node dist/index.js --new-key
FOUNDRY_KEY=

# ── Only for --http mode (claude.ai, or a relay on another machine) ──
# Public HTTPS address of this relay, as Claude will reach it.
PUBLIC_URL=https://foundry-bridge.example.com
# Password you type when connecting Claude for the first time. At least 12 characters.
RELAY_PASSWORD=
# Optional static bearer token for Claude Code. Generate with: openssl rand -hex 32
API_KEY=

PORT=8787
CALL_TIMEOUT_MS=30000
