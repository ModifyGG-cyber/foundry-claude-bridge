# Public HTTPS address of this relay, as Claude will reach it (no trailing path).
PUBLIC_URL=https://foundry-bridge.example.com

# Shared with the Foundry module's "Relay secret" setting. Generate with: openssl rand -base64 33
FOUNDRY_SECRET=

# Password you type when connecting Claude for the first time. At least 12 characters.
RELAY_PASSWORD=

# Optional static bearer token for Claude Code / Claude Desktop config files. Generate with: openssl rand -hex 32
API_KEY=

PORT=8787
CALL_TIMEOUT_MS=30000
